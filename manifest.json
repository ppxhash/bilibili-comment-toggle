{
  "manifest_version": 3,
  "name": "B站评论区开关 · 自写版",
  "version": "1.0.0",
  "description": "一键隐藏/显示 B 站视频页评论区。纯本地运行，不申请网络权限，无任何数据上报。",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.bilibili.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "切换评论区显示/隐藏（也可按 Alt+C）"
  },
  "commands": {
    "toggle-comments": {
      "suggested_key": {
        "default": "Alt+C"
      },
      "description": "切换评论区显示/隐藏"
    }
  }
}
